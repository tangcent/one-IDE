{
  "name": "one-ide",
  "displayName": "One-IDE",
  "icon": "icon.png",
  "description": "Seamlessly sync your editors across JetBrains IDEs and VS Code, with automatic AI project rule adaptation.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "publisher": "tangcent",
  "author": {
    "name": "tangcent",
    "email": "pentatangcent@gmail.com",
    "url": "https://github.com/tangcent/one-IDE"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tangcent/one-IDE"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "One-IDE",
      "properties": {
        "oneIde.excludeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns to exclude from syncing."
        },
        "oneIde.excludeGitIgnore": {
          "type": "boolean",
          "default": false,
          "description": "Whether to exclude files ignored by .gitignore."
        },
        "oneIde.ai.syncRules": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI Project Rules synchronization."
        },
        "oneIde.ai.currentTool": {
          "type": "string",
          "enum": [
            "Auto",
            "Trae",
            "Cursor",
            "Windsurf",
            "Copilot",
            "Claude",
            "JetBrains",
            "Junie",
            "Qodo",
            "Qoder",
            "Antigravity"
          ],
          "default": "Auto",
          "description": "Explicitly set the current AI tool. Use 'Auto' to detect automatically."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -noEmit && node esbuild.js",
    "watch": "tsc -noEmit -watch -p ./ & node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc -noEmit",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha -r ts-node/register -r tsconfig-paths/register 'src/test/services/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.11",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ignore": "^5.3.0",
    "minimatch": "^9.0.3",
    "uuid": "^9.0.1"
  }
}
