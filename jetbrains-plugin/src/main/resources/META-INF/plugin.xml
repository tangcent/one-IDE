<idea-plugin>
    <id>com.itangcent.oneide</id>
    <name>One-IDE</name>
    <vendor email="pentatangcent@gmail.com" url="https://github.com/tangcent/one-IDE">tangcent</vendor>
    <description>
        <![CDATA[
        <!-- Description injected by Gradle -->
        ]]>
    </description>
    <depends>com.intellij.modules.platform</depends>
    
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.oneide.OneIDEPlugin"/>
        <statusBarWidgetFactory id="OneIDEStatusBar" implementation="com.oneide.OneIDEStatusBarWidgetFactory"/>
        <projectService serviceImplementation="com.oneide.models.IdeMetaData"/>
        <projectService serviceImplementation="com.oneide.SyncService"/>
        <applicationService serviceImplementation="com.oneide.services.AITool"/>
        <projectConfigurable instance="com.oneide.settings.OneIDESettingsConfigurable" displayName="One-IDE" />
        <notificationGroup id="OneIDE Notification Group" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="OneIDE.ToggleSync" class="com.oneide.ToggleSyncAction" text="Toggle One-IDE Sync" description="Enable or disable One-IDE synchronization">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
